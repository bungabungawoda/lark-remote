{
  "name": "lark-remote",
  "version": "0.1.4",
  "description": "Feishu (Lark) private-chat bridge to local coding agents — Claude Code / Codex / opencode / pi / kimi, with live-streaming CardKit 2.0 cards",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "lark-remote": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.js.map",
    "!dist/**/*.d.ts.map",
    "!dist/config/codex-bundled-test-helpers.*",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "bun src/index.ts",
    "build": "rm -rf dist && tsc && chmod +x dist/index.js dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bridge": "vitest run --project infra-bridge",
    "test:card": "vitest run --project infra-card",
    "test:connector": "vitest run --project infra-connector",
    "test:router": "vitest run --project infra-router",
    "test:session": "vitest run --project infra-session",
    "test:runner": "vitest run --project infra-runner",
    "test:config": "vitest run --project infra-config",
    "test:order": "vitest run --project infra-order",
    "test:misc": "vitest run --project infra-misc",
    "test:claude": "vitest run --project agent-claude",
    "test:codex": "vitest run --project agent-codex",
    "test:opencode": "vitest run --project agent-opencode",
    "test:pi": "vitest run --project agent-pi",
    "test:kimi": "vitest run --project agent-kimi",
    "test:bash": "vitest run --project agent-bash",
    "test:infra": "vitest run --project 'infra-*'",
    "test:agents": "vitest run --project 'agent-*'",
    "test:codex-full": "vitest run --project agent-codex --project infra-runner --project infra-session",
    "test:claude-full": "vitest run --project agent-claude --project infra-runner --project infra-session",
    "test:opencode-full": "vitest run --project agent-opencode --project infra-runner --project infra-session",
    "test:pi-full": "vitest run --project agent-pi --project infra-runner --project infra-session",
    "test:kimi-full": "vitest run --project agent-kimi --project infra-runner --project infra-session",
    "test:live": "vitest run --project live",
    "prepublishOnly": "tsc --noEmit && vitest run && rm -rf dist && tsc && chmod +x dist/index.js dist/cli.js",
    "prepack": "node -e \"const fs=require('fs');if(!fs.existsSync('dist/cli.js')){console.error('dist/ missing — run bun run build first');process.exit(1)}\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "feishu",
    "lark",
    "claude-code",
    "codex",
    "opencode",
    "kimi",
    "coding-agent",
    "bridge",
    "cli",
    "remote-control"
  ],
  "author": "bungabungawoda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bungabungawoda/lark-remote.git"
  },
  "bugs": {
    "url": "https://github.com/bungabungawoda/lark-remote/issues"
  },
  "homepage": "https://github.com/bungabungawoda/lark-remote#readme",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@larksuite/channel": "^0.3.0",
    "axios": "^1.18.0",
    "form-data": "^4.0.6",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/form-data": "^2.5.2",
    "@types/node": "^26.1.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
